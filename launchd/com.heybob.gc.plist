<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional daily `bob gc` sweep. Documented, deliberately NOT auto-installed — a background
  job that stops sessions is something you should switch on knowingly.

  Install:
    cp launchd/com.heybob.gc.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.heybob.gc.plist
  Remove:
    launchctl unload ~/Library/LaunchAgents/com.heybob.gc.plist

  The hour is 04:37 rather than 04:00 on purpose: nothing else on this machine wakes at an
  odd minute, so the sweep never contends with the tidy-on-the-hour crowd.

  launchd offers no $HOME expansion, so every /Users/YOURNAME/... path below must be
  replaced with a real absolute path before this is loaded: the `bob` binary is wherever
  `bun link` shimmed it (typically ~/.local/bin/bob), and the log paths belong under your
  state home (BOB_HOME if you set it, otherwise ~/bob).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.heybob.gc</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOURNAME/.local/bin/bob</string>
    <string>gc</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd starts with almost no PATH; `bob`'s shebang needs bun on it. -->
    <key>PATH</key>
    <string>/Users/YOURNAME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>37</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/YOURNAME/bob/logs/gc-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOURNAME/bob/logs/gc-launchd.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
